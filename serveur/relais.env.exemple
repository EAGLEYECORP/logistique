# Configuration du relais Logistique Fret — copiez ce fichier en « relais.env » à côté, et remplacez les valeurs.
# Gardez relais.env secret : il contient les jetons et la clé de chiffrement. Une ligne par réglage, sans espace autour du « = ».
PORT=8787
# Jetons : longues chaînes au hasard (l'application, Réglages → Relais, peut vous en tirer).
JETON_ECRITURE=remplacez-par-un-jeton-long
JETON_LECTURE=remplacez-par-un-autre-jeton-long
CHIFFRER_DONNEES=true
CLE_DONNEES=remplacez-par-une-phrase-secrete-longue
# Plusieurs utilisateurs (l'application servie par le relais) :
# MULTI_UTILISATEUR=true
# Adresse publique en https (lien de suivi des clients) :
# URL_PUBLIQUE=https://fret.mon-entreprise.ma
# E-mail (factures, relances) :
# SMTP_HOTE=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURITE=tls
# SMTP_UTILISATEUR=compta@mon-entreprise.ma
# SMTP_MOT_DE_PASSE=mot-de-passe-d-application
# SMTP_DE=compta@mon-entreprise.ma
# Boîte des demandes : la boîte qui reçoit les demandes des clients, relue en lecture seule toutes les 5 minutes
# IMAP_HOTE=imap.gmail.com
# IMAP_UTILISATEUR=contact@mon-entreprise.ma
# IMAP_MOT_DE_PASSE=mot-de-passe-d-application
# IMAP_DOSSIER=INBOX
# IMAP_INTERVALLE_MIN=5
